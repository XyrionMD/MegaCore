<?xml version='1.0' encoding='utf-8'?>
<widget id="com.mc.id" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>MegaCore</name>
    <description>
        Aplikasi buatan dengan Apache Cordova dari HTML, CSS, dan JS.
    </description>
    <author email="you@example.com" href="https://example.com">
        Kamu
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <platform name="android">
        <allow-intent href="market:*" />
    </platform>
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
    </platform>
</widget>
